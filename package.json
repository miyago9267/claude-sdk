{
  "name": "@miyago/claude-sdk",
  "version": "1.6.0",
  "type": "module",
  "private": false,
  "description": "Patched Claude Agent SDK — V2 persistent session, context management, Ollama-compatible bridge for IDE clients (GitHub Copilot Chat, etc.), CLI harness",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "claude-sdk": "src/cli/bin.ts"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./context": {
      "bun": "./src/context-manager.ts",
      "types": "./src/context-manager.ts",
      "import": "./src/context-manager.ts",
      "default": "./src/context-manager.ts"
    },
    "./shared": {
      "bun": "./src/shared/messages.ts",
      "types": "./src/shared/messages.ts",
      "import": "./src/shared/messages.ts",
      "default": "./src/shared/messages.ts"
    },
    "./ollama": {
      "bun": "./src/ollama/index.ts",
      "types": "./src/ollama/index.ts",
      "import": "./src/ollama/index.ts",
      "default": "./src/ollama/index.ts"
    },
    "./cli": {
      "bun": "./src/cli/index.ts",
      "types": "./src/cli/index.ts",
      "import": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    }
  },
  "scripts": {
    "test": "bun test src/",
    "ollama": "bun src/cli/bin.ts --ollama",
    "tui": "bun src/cli/bin.ts --tui",
    "build:tui": "bash scripts/build-tui.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.177",
    "hono": "^4.12.15"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "files": [
    "src/index.ts",
    "src/context-manager.ts",
    "src/optimize/",
    "src/shared/",
    "src/ollama/",
    "src/cli/",
    "cmd/tui/",
    "scripts/build-tui.sh"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/miyago9267/claude-sdk.git"
  },
  "license": "MIT",
  "keywords": [
    "claude",
    "anthropic",
    "agent-sdk",
    "prompt-caching",
    "persistent-session",
    "context-management",
    "ollama",
    "ollama-bridge",
    "github-copilot",
    "cli"
  ]
}
