{
  "name": "@miyago/claude-sdk",
  "version": "1.7.0",
  "type": "module",
  "private": false,
  "description": "Claude Agent SDK wrapper — persistent sessions, context management, and Ollama-compatible protocol bridge",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./context": {
      "bun": "./src/context-manager.ts",
      "types": "./src/context-manager.ts",
      "import": "./src/context-manager.ts",
      "default": "./src/context-manager.ts"
    },
    "./shared": {
      "bun": "./src/shared/messages.ts",
      "types": "./src/shared/messages.ts",
      "import": "./src/shared/messages.ts",
      "default": "./src/shared/messages.ts"
    },
    "./ollama": {
      "bun": "./src/ollama/index.ts",
      "types": "./src/ollama/index.ts",
      "import": "./src/ollama/index.ts",
      "default": "./src/ollama/index.ts"
    },
    "./runtime": {
      "bun": "./src/runtime/index.ts",
      "types": "./src/runtime/index.ts",
      "import": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    }
  },
  "scripts": {
    "test": "bun test src/",
    "update:agent-sdk": "bash scripts/update-agent-sdk.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.238",
    "@anthropic-ai/sdk": "0.120.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "hono": "^4.12.15"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "files": [
    "src/index.ts",
    "src/context-manager.ts",
    "src/optimize/",
    "src/shared/",
    "src/ollama/",
    "src/runtime/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/miyago9267/claude-sdk.git"
  },
  "license": "MIT",
  "keywords": [
    "claude",
    "anthropic",
    "agent-sdk",
    "prompt-caching",
    "persistent-session",
    "context-management",
    "ollama",
    "ollama-bridge",
    "github-copilot",
    "agent-bot",
    "api-bridge"
  ]
}
