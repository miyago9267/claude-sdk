{
  "name": "@miyago/claude-sdk",
  "version": "1.3.0",
  "type": "module",
  "private": false,
  "description": "Patched Claude Agent SDK — V2 persistent session, context management, OpenAI-compatible adapter, CLI harness",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "claude-sdk": "src/cli/bin.ts"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./context": {
      "bun": "./src/context-manager.ts",
      "types": "./src/context-manager.ts",
      "import": "./src/context-manager.ts",
      "default": "./src/context-manager.ts"
    },
    "./openai": {
      "bun": "./src/openai/index.ts",
      "types": "./src/openai/index.ts",
      "import": "./src/openai/index.ts",
      "default": "./src/openai/index.ts"
    },
    "./cli": {
      "bun": "./src/cli/index.ts",
      "types": "./src/cli/index.ts",
      "import": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    }
  },
  "scripts": {
    "postinstall": "bash scripts/postinstall.sh",
    "patch:check": "bash scripts/patch-v2.sh --check",
    "patch:v2": "bash scripts/patch-v2.sh",
    "patch:cli": "bash scripts/patch.sh",
    "test": "bun test src/",
    "serve": "bun src/cli/bin.ts --serve"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.90",
    "hono": "^4.12.15"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "files": [
    "src/index.ts",
    "src/context-manager.ts",
    "src/optimize/",
    "src/openai/",
    "src/cli/",
    "scripts/patch-v2.mjs",
    "scripts/patch-v2.sh",
    "scripts/patch.sh",
    "scripts/postinstall.sh"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/miyago9267/claude-sdk.git"
  },
  "license": "MIT",
  "keywords": [
    "claude",
    "anthropic",
    "agent-sdk",
    "prompt-caching",
    "persistent-session",
    "context-management",
    "openai-compatible",
    "cli"
  ]
}
